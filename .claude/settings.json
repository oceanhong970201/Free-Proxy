{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/inject-sources.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/deny-destructive.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git clean *)",
      "Bash(git reset --hard *)",
      "Bash(git push --force *)"
    ]
  },
  "model": "",
  "effort": ""
}
